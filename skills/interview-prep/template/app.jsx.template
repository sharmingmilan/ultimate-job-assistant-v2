  const sql = (CONTENT.patterns && CONTENT.patterns.sql) || [];
  const py = (CONTENT.patterns && CONTENT.patterns.python) || [];
  if (sql.length === 0 && py.length === 0) {
    return (
      <section>
        <h1 className="text-2xl font-bold text-slate-100 mb-3">Patterns</h1>
        <p className="text-slate-400">No patterns recorded for this build.</p>
      </section>
    );
  }
  return (
    <section>
      <h1 className="text-2xl font-bold text-slate-100 mb-3">Patterns to Drill</h1>
      {sql.length > 0 && (
        <div className="mb-6">
          <h2 className="text-lg font-semibold text-pink-400 mb-2">SQL ({sql.length})</h2>
          {sql.map((p, i) => (
            <div key={i} className="rounded border border-slate-700 bg-slate-900/50 p-3 mb-2">
              <h3 className="font-semibold text-slate-100">{p.title}</h3>
              <p className="text-sm text-slate-300 mt-1">{p.summary}</p>
              {p.snippet && <pre className="text-xs bg-slate-950 border border-slate-800 rounded p-2 mt-2 text-slate-300 overflow-x-auto">{p.snippet}</pre>}
            </div>
          ))}
        </div>
      )}
      {py.length > 0 && (
        <div>
          <h2 className="text-lg font-semibold text-sky-400 mb-2">Python ({py.length})</h2>
          {py.map((p, i) => (
            <div key={i} className="rounded border border-slate-700 bg-slate-900/50 p-3 mb-2">
              <h3 className="font-semibold text-slate-100">{p.title}</h3>
              <p className="text-sm text-slate-300 mt-1">{p.summary}</p>
              {p.snippet && <pre className="text-xs bg-slate-950 border border-slate-800 rounded p-2 mt-2 text-slate-300 overflow-x-auto">{p.snippet}</pre>}
            </div>
          ))}
        </div>
      )}
    </section>
  );
}

