                    view.kind === "topic" && view.topicId === t.id
                      ? "bg-sky-900/40 text-sky-200"
                      : "text-slate-300 hover:bg-slate-800"
                  }`}
                  onClick={() => { setView({ kind: "topic", topicId: t.id }); setNavOpen(false); }}
                >
                  <span className="text-xs text-slate-500 mr-1">{t.tier}</span>
                  {t.title}
                </button>
              </li>
            ))}
          </ul>
          <p className="text-xs text-slate-500 uppercase tracking-wider mt-4 mb-2">Other</p>
          <ul className="space-y-1">
            <li>
              <button
                className={`w-full text-left px-2 py-1.5 rounded text-sm ${
                  view.kind === "real" ? "bg-sky-900/40 text-sky-200" : "text-slate-300 hover:bg-slate-800"
                }`}
                onClick={() => { setView({ kind: "real" }); setNavOpen(false); }}
              >
                Real Questions {realCount > 0 && <span className="text-slate-500">({realCount})</span>}
              </button>
            </li>
            {hasPatterns && (
              <li>
                <button
                  className={`w-full text-left px-2 py-1.5 rounded text-sm ${
                    view.kind === "patterns" ? "bg-sky-900/40 text-sky-200" : "text-slate-300 hover:bg-slate-800"
                  }`}
                  onClick={() => { setView({ kind: "patterns" }); setNavOpen(false); }}
                >
                  Patterns
                </button>
              </li>
            )}
          </ul>
        </nav>

        <main className="flex-1 p-4 max-w-4xl">
          {view.kind === "topic" && currentTopic && <TopicPage topic={currentTopic} />}
          {view.kind === "real" && <RealQuestionsPage />}
          {view.kind === "patterns" && <PatternsPage />}
          <Footer />
        </main>
      </div>
    </div>
  );
}
