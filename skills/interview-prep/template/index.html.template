<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#0f172a" />
  <title>{{TITLE}} — Interview Prep</title>
  <link rel="manifest" href="manifest.json" />
  <link rel="apple-touch-icon" href="icon-192.png" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="{{COMPANY}} Prep" />

  <!-- React + Tailwind + Babel via jsDelivr CDN -->
  <script src="https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js" crossorigin></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://cdn.jsdelivr.net/npm/@babel/standalone@7.25.6/babel.min.js" crossorigin></script>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <style>
    html, body, #root { height: 100%; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      -webkit-font-smoothing: antialiased;
    }
    .editor-wrap {
      position: relative;
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 13px;
      line-height: 1.5;
    }
    .editor-wrap pre,
    .editor-wrap textarea {
      margin: 0;
      padding: 12px;
      border: 1px solid #334155;
      border-radius: 6px;
      background: #0b1224;
      color: #e2e8f0;
      tab-size: 2;
      white-space: pre-wrap;
      word-break: break-word;
      overflow-wrap: break-word;
      min-height: 160px;
    }
    .editor-wrap pre {
      pointer-events: none;
      position: absolute;
      inset: 0;
      color: #e2e8f0;
    }
    .editor-wrap textarea {
      position: relative;
      z-index: 1;
      resize: vertical;
      width: 100%;
      color: transparent;
      caret-color: #e2e8f0;
      background: transparent;
    }
    .tok-kw { color: #f472b6; }
    .tok-fn { color: #38bdf8; }
    .tok-str { color: #4ade80; }
    .tok-num { color: #fbbf24; }
    .tok-com { color: #94a3b8; font-style: italic; }
    .scaffold-blank { color: #fb923c; font-weight: 600; }
  </style>
</head>
<body>
  <div id="root"></div>

  <script>
    // Content is injected by the build script.
    window.__CONTENT__ = {{CONTENT_JSON}};
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('sw.js').catch(() => {});
      });
    }
  </script>

  <script type="text/babel" data-presets="react">
{{APP_JSX}}

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
