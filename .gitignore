# OS files
.DS_Store
Thumbs.db

# Lock files (LibreOffice/Word temp files)
.~lock.*

# Editor/IDE
*.swp
*.swo
*~
.vscode/
.idea/
.cursor/

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Environment
.env
.env.local
.env.*

# ─── Personal data (do not push) ──────────────────────────────
# These hold real applicant data and per-application outputs.
# Skill code and templates remain tracked.

base-resumes/
research/
resumes/
scores/
speaking-points/
cover-letters/
applications/
archive/
portfolio/
networking/

# Personal interview-prep artifacts (PDFs, MDs, HTML, per-application PWA outputs).
# The folder is tracked via .gitkeep but its contents are user-data only.
interview-prep/*
!interview-prep/.gitkeep

# Root-level reference PDFs that came from prior sessions
netflix-codesignal-prep.pdf

# Decoded JDs may contain proprietary content from postings.
# Tracked via .gitkeep; .md/.pdf contents excluded.
decoded-jds/*
!decoded-jds/.gitkeep

# Build outputs / temp
node_modules/
*.log
/tmp/

# The website's downloadable zip is built in the deploy-source (public) repo
# by scripts/sync_to_public.py. The canonical repo never carries it; if a
# stray copy lands here from a manual test, ignore it rather than commit it.
website/downloads/ultimate-job-assistant.zip

# Local backup files (e.g., .docx.bak created during sanitization passes).
# These often contain pre-redaction PII. Never commit them.
*.bak
*~bak
*.orig

# FUSE workaround: shed-renamed files when OS unlink is blocked.
*.shed-*

# Credential tempfiles. The token-rotation flow (sessions where Claude needs
# to rotate the canonical's git remote PAT) writes the new token to
# .token-new.tmp briefly, reads it, then deletes it. This rule makes sure
# it can never accidentally be committed during the window where it exists.
.token-new.tmp
.token-*.tmp
